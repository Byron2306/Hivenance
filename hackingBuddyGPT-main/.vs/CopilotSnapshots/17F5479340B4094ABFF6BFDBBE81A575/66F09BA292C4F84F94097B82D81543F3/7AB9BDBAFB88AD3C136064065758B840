import datetime
from dataclasses import dataclass
from typing import Any, Dict, Iterable, Optional

import requests
import tiktoken

from hackingBuddyGPT.utils.configurable import configurable, parameter
from hackingBuddyGPT.utils.llm_util import LLM, LLMResult


@configurable("ollama", "Ollama LLM API")
@dataclass
class OllamaConnection(LLM):
    model: str = parameter(desc="Ollama model name")
    context_size: int = parameter(desc="Maximum context size for the model", default=4096)
    api_url: str = parameter(desc="URL of the Ollama API", default="http://localhost:11434")
    api_timeout: int = parameter(desc="Timeout for the API request", default=240)

    def init(self):
        pass  # No special init needed for Ollama

    def get_response(self, prompt, *, capabilities=None, **kwargs) -> LLMResult:
        if isinstance(prompt, list):
            # Convert list of messages to a single string for Ollama
            prompt_text = "\n".join([msg.get("content", "") for msg in prompt if isinstance(msg, dict)])
        else:
            prompt_text = str(prompt)

        data = {
            "model": self.model,
            "prompt": prompt_text,
            "stream": False  # Disable streaming for simplicity
        }

        tic = datetime.datetime.now()
        try:
            response = requests.post(f"{self.api_url}/api/generate", json=data, timeout=self.api_timeout)
            response.raise_for_status()
        except requests.exceptions.RequestException as e:
            raise Exception(f"Error contacting Ollama API: {e}")

        result = response.json()
        answer = result.get("response", "")
        duration = datetime.datetime.now() - tic

        # Estimate token counts (Ollama doesn't provide exact counts)
        tok_query = len(self.encode(prompt_text))
        tok_res = len(self.encode(answer))

        return LLMResult(
            result=result,
            prompt=prompt_text,
            answer=answer,
            duration=duration,
            tokens_query=tok_query,
            tokens_response=tok_res,
        )

    def encode(self, query) -> list[int]:
        # Use tiktoken for approximation (not perfect for Ollama models)
        try:
            encoding = tiktoken.encoding_for_model("gpt-3.5-turbo")  # Fallback
        except:
            encoding = tiktoken.get_encoding("cl100k_base")
        return encoding.encode(query)